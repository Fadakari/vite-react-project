# تنظیمات اصلی جنگو
SECRET_KEY=django-insecure-gerahgosha-key-change-this-in-production-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# تنظیمات دیتابیس (اختیاری: اگر خالی باشد از دیتابیس داخلی SQLite استفاده می‌شود که بدون هیچ تنظیمی کار می‌کند)
# اگر در هاست سی‌پنل دیتابیس MySQL ساختید، مقادیر زیر را پر کنید:
USE_MYSQL=False
DB_NAME=cpaneluser_gerahgosha
DB_USER=cpaneluser_dbuser
DB_PASSWORD=your_strong_password
DB_HOST=localhost
DB_PORT=3306

# آدرس فرانت‌اند برای CORS (می‌توانید چند دامنه را با کاما جدا کنید)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
